# 页面标题
VUE_APP_TITLE = 一体两翼管理平台

# 生产环境配置
ENV = 'production'

# 一体两翼管理平台/生产环境
VUE_APP_BASE_API = '/prod-api'

# 密钥（前端后端需要保持一致）
VUE_APP_ENCRYPT_KEY = '0123456789abcdef0123456789abcdef'

# 这里控制是否加密
VUE_APP_ENCRYPT_ENABLED = true

VUE_APP_NO_ENCRYPT_URLS = "/captchaImage,/logout,/captcha/get,/captcha/check,/export"

# OSS重定向
VUE_APP_OSS_REPLACE = true

# OSS源地址
VUE_APP_OSS_SRC = https://ytly.shunxuan.net.cn

# OSS目标地址
VUE_APP_OSS_DST = http://172.24.160.42
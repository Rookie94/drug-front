# 页面标题
VUE_APP_TITLE = 一体两翼管理平台

# 开发环境配置
ENV = 'development'

# 一体两翼管理平台/开发环境
VUE_APP_BASE_API = '/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 密钥（前端后端需要保持一致）
VUE_APP_ENCRYPT_KEY = '0123456789abcdef0123456789abcdef'

# 这里控制是否加密
VUE_APP_ENCRYPT_ENABLED = false

VUE_APP_NO_ENCRYPT_URLS = "/captchaImage,/logout"